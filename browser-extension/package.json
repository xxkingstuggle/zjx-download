{
  "name": "zjx-download-chrome-extension",
  "version": "1.5.0",
  "displayName": "zjx-download",
  "shortName": "zjx-download",
  "author": "AmirHossein Abdolmotallebi",
  "description": "Send browser downloads to the zjx-download macOS app.",
  "repository": "https://github.com/xxkingstuggle/zjx-download",
  "homepage": "https://github.com/xxkingstuggle/zjx-download",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm run build:chrome",
    "build:chrome": "npm run licenses && cross-env EXTENSION_TARGET=chrome vite build && node scripts/check-manifest-assets.mjs chrome",
    "build:firefox": "cross-env EXTENSION_TARGET=firefox vite build && node scripts/check-manifest-assets.mjs firefox",
    "check:manifest": "node scripts/check-manifest-assets.mjs chrome",
    "check:manifest:all": "node scripts/check-manifest-assets.mjs all",
    "licenses": "node scripts/generate-third-party-notices.mjs",
    "test:link-extractor": "node tests/link-extractor.test.cjs",
    "test:download-fallback": "node tests/download-fallback.test.cjs",
    "test:brand": "node tests/brand.test.cjs",
    "test:accessibility": "node tests/accessibility.test.cjs",
    "test": "npm run test:link-extractor && npm run test:download-fallback && npm run test:brand && npm run test:accessibility",
    "watch:chrome": "cross-env EXTENSION_TARGET=chrome vite build --watch --mode development --minify false",
    "watch:firefox": "cross-env EXTENSION_TARGET=firefox vite build --watch --mode development --minify false",
    "dev": "vite",
    "pack:src": "git archive HEAD -o ./dist/src.zip",
    "pack:firefox": "npm run build:firefox && web-ext build --source-dir ./dist/firefox --artifacts-dir ./dist --filename firefox.zip",
    "pack:chrome": "npm run build:chrome && web-ext build --source-dir ./dist/chrome --artifacts-dir ./dist --filename \"zjx-download-chrome-${npm_package_version}.zip\" --overwrite-dest",
    "pack": "npm run pack:chrome",
    "serve:firefox": "web-ext run --firefox-profile default-release --start-url \"about:debugging#/runtime/this-firefox\"  --source-dir ./dist/firefox --devtools",
    "serve:chrome": "web-ext run -t chromium --start-url \"https://example.com\" --source-dir ./dist/chrome"
  },
  "devDependencies": {
    "@samrum/vite-plugin-web-extension": "^5.1.1",
    "@types/chrome": "^0.0.321",
    "@types/lodash": "^4.17.16",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.1",
    "@types/webextension-polyfill": "^0.12.3",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "daisyui": "^4.4.19",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.0.4",
    "vite": "~4.3.9",
    "vite-plugin-environment": "^1.1.3",
    "web-ext": "^8.10.0"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "hls-parser": "^0.15.0",
    "is-network-error": "^1.0.0",
    "lodash": "^4.17.21",
    "match-url-wildcard": "^0.0.5",
    "mobx": "^6.12.0",
    "mobx-react-lite": "^4.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "webext-bridge": "^6.0.1",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.4.3"
  }
}
