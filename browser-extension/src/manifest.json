{
  "manifest_version": 3,
  "name": "zjx-download",
  "short_name": "zjx-download",
  "version": "2.0.5",
  "author": "Xin (@xxkingstuggle)",
  "homepage_url": "https://myzjx.com/software/zjx-download/",
  "key": "",
  "description": "把 Chrome 下载请求发送到 zjx-download macOS 应用。",
  "permissions": ["alarms", "contextMenus", "storage", "tabs", "scripting", "downloads", "notifications", "nativeMessaging"],
  "optional_permissions": ["webRequest", "cookies"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "zjx-download", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"},
  "commands": {"toggle-auto-capture": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "切换下载接管"}}
}
